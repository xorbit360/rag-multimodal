# Copia a .env y completa solo lo que vayas a usar. NUNCA subas .env a git.
# Proveedor LLM OpenAI-compatible: openai | openrouter | ollama | demo
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1 y OPENAI_MODEL=<modelo openrouter>
# Ollama local: OPENAI_BASE_URL=http://localhost:11434/v1 y OPENAI_MODEL=llama3.1
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384
VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks
QUEUE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
API_URL=http://localhost:8000
STORAGE_DIR=storage
DEMO_MODE=true
LOG_LEVEL=INFO
# Guardado de tokens en el servidor (cifrado Fernet). Genera una clave con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sin esta clave, guardar un token falla con mensaje claro (nunca en plano).
# La predeterminada compartida la establece el dueno con
# scripts/set_default_token.py (ver README). Nunca subas una clave a Git.
TOKEN_ENCRYPTION_KEY=
